# Server Configuration
NODE_ENV=development
PORT=5050
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://lifeshelf:lifeshelf_secret@localhost:5432/lifeshelf_db?schema=public

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_lifeshelf_production_ready_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# AES-256-GCM Encryption Key for Cloud Credentials at Rest (Must be 32 bytes / 64 hex characters or 32 raw chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional Application-Level Global Cloudinary (for built-in fallbacks if configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
